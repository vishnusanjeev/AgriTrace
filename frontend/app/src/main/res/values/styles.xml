<resources>

    <!-- App Theme -->
    <style name="Theme.MyApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#10001F</item>
        <item name="colorAccent">#0D0712</item>
    </style>
    <style name="Theme.AgriTrace.Launch" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_launch_green</item>
        <item name="android:statusBarColor">#0B8F63</item>
        <item name="android:navigationBarColor">#0B8F63</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowAnimationStyle">@style/AppWindowAnimations</item>
       <!-- IMPORTANT: keep preview enabled so the system shows your background immediately -->
        <item name="android:windowDisablePreview">false</item>
    </style>
    <style name="RetailerBottomNavText">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="DistBottomNavText">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="AgriChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/chip_text_irrigation</item>

        <item name="chipMinHeight">50dp</item>
        <item name="chipCornerRadius">12dp</item>

        <item name="chipStrokeWidth">2dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_irrigation</item>
        <item name="chipBackgroundColor">@color/chip_bg_irrigation</item>

        <!-- FIX: use rippleColor (chipRippleColor is not a valid attr here) -->
        <item name="rippleColor">@color/chip_ripple_irrigation</item>

        <item name="checkedIconVisible">false</item>

        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>
    <!-- Profile Menu Item Style -->
    <style name="ProfileItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:drawableEnd">@drawable/ic_arrow</item>
        <item name="android:drawablePadding">12dp</item>
    </style>
    <style name="BottomIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_margin">24dp</item>
        <item name="android:tint">#777</item>
    </style>
    <style name="AppWindowAnimations">
        <item name="android:activityOpenEnterAnimation">@anim/at_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/at_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/at_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/at_close_exit</item>

        <item name="android:taskOpenEnterAnimation">@anim/at_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/at_open_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/at_close_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/at_close_exit</item>

        <item name="android:taskToFrontEnterAnimation">@anim/at_open_enter</item>
        <item name="android:taskToFrontExitAnimation">@anim/at_open_exit</item>
        <item name="android:taskToBackEnterAnimation">@anim/at_close_enter</item>
        <item name="android:taskToBackExitAnimation">@anim/at_close_exit</item>
    </style>


</resources>
